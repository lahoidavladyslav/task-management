# Used when running the API outside Docker. Docker Compose has its own defaults.
DATABASE_URL=postgresql+asyncpg://taskmanager:taskmanager@localhost:5432/taskmanager
# development | production. In production a placeholder SECRET_KEY aborts startup.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_ACTIVE_TASKS_PER_USER=10
OVERDUE_WORKER_ENABLED=true
DOCS_ENABLED=true
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_ATTEMPTS=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RUN_MIGRATIONS=true
OVERDUE_CHECK_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# Docker Compose overrides (optional)
# POSTGRES_USER=taskmanager
# POSTGRES_PASSWORD=taskmanager
# POSTGRES_DB=taskmanager
# API_PORT=8000
